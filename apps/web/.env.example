# Move for Gaza — anteprima sito (default in codice: zipangulo se non impostata)
# M4G_SITE_PASSWORD=

# Nexi / XPay (sandbox int-ecommerce; in locale servono URL che passano da /nexi/success e /nexi/failure)
# NEXI_MERCHANT_ID=
# NEXI_API_KEY=
NEXI_ENDPOINT=https://int-ecommerce.nexi.it/ecomm/ecomm/DispatcherServlet
NEXI_SUCCESS_URL=http://127.0.0.1:8000/nexi/success
NEXI_FAILURE_URL=http://127.0.0.1:8000/nexi/failure

# Link colletta Satispay e PayPal Pool
# M4G_SATISPAY_LINK=https://web.satispay.com/download/qrcode/S6Y-SVN--2272D1CA-C3EC-4F11-A43F-BB71071263F3?locale=it_IT
# M4G_PAYPAL_LINK=https://www.paypal.com/pool/9iq3YyxOcH?sr=wccr

# WattLab (app desktop tesserati)
WATTLAB_VERSION=0.1.0
WATTLAB_RELEASES_DIR=releases/wattlab
# WATTLAB_INSTALLER_PATH=/data/releases/wattlab/WattLab_0.1.0_x64-setup.exe

# URL pubblico del sito (callback OAuth Strava).
APP_PUBLIC_URL=https://amarobici.it

# App Strava del club (strava.com/settings/api).
# Authorization Callback Domain = amarobici.it
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
