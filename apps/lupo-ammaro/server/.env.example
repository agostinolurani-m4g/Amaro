PORT=8000
WATTLAB_JWT_SECRET=dev-wattlab-secret-change-me
WATTLAB_TOKEN_TTL_HOURS=168
WATTLAB_VERSION=0.1.1
WATTLAB_INSTALLER=WattLab_0.1.1_x64-setup.exe
# WATTLAB_RELEASES_DIR=./server/releases

# Coach AI — Ollama (default, locale). API nativa /api/chat con contesto esteso.
#   ollama pull qwen2.5:14b   (fallback: ollama pull llama3.1)
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:14b
LLM_FALLBACK_MODEL=llama3.1
LLM_NUM_CTX=8192
# LLM_NUM_CTX=16384   # più contesto, più lento su CPU/GPU limitata
# LLM_KEEP_ALIVE=30m
LLM_TIMEOUT_MS=180000
# COACH_LLM_TIMEOUT_MS=300000   # opzionale: solo loop coach (multi-step)
# LLM_TEMPERATURE=0.2
# LLM_TOOL_ROUTING=on   # subset di tool per messaggio (sempre attivo con Ollama)

# Alternativa: LM Studio → LLM_PROVIDER=openai, LLM_BASE_URL=http://127.0.0.1:1234/v1

# Coach AI — Anthropic Claude (consigliato in produzione / se Ollama è lento)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
# LLM_MODEL=claude-haiku-4-5
# LLM_TIMEOUT_MS=120000
# LLM_MAX_TOKENS=4096

# Coach AI — OpenAI-compatibile
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Strava OAuth (https://www.strava.com/settings/api)
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://127.0.0.1:8000/api/wattlab/strava/callback
